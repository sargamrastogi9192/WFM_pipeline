# WFM flow settings — copy to wfm_flow/.env (cp wfm_flow/wfm.env.example wfm_flow/.env) and change what differs.
# Every key has a default (wfm_flow/settings.py); an environment variable of the same name wins.
# The database host / user / password are the repository's own .env (DB_HOST, DB_USER, DB_PASSWORD / DB_SECRET_NAME).

# the WFM uploads: <root>/<survey id>/D1..D4/<upload timestamp>-<file name>
WFM_REPORTS_S3_ROOT=s3://nhai-dhms-uat/wfm_reports/staging/wfm/reports/
# the migrated copy (unzipped, no videos) in the layout bronze reads; the run's RAW_S3_ROOT
WFM_STAGE_S3=s3://dhms-new-stgae/DHMS/NSV/WFM_Raw/
# processed log mirrored here (empty = local only: logs/wfm/state/)
WFM_STATE_S3=s3://dhms-new-stgae/DHMS/NSV/Pipeline/wfm_state

# database / schema with wfm_survey_schedule + wfm_report (empty = DB_NAME / DB_SCHEMA of the repository .env)
WFM_DB_NAME=
WFM_DB_SCHEMA=
# processed when wfm_survey_schedule.current_status is one of these (comma separated)
WFM_FINAL_STATUSES=Survey Final Approved
WFM_SOURCE_SYSTEM=NSV
# a failed survey (copy error / crash) is retried this many times
WFM_MAX_ATTEMPTS=3
# stages whose WARNING is recorded and the survey goes on (empty = stop at every warning, as run.py --scheduled);
# a FAILED step always stops, and the database stages write only after a clean check
WFM_CONTINUE_ON_WARNING=bronze,silver,images
# local: processed log, Postgres rows and migration manifests of each survey
WFM_WORK_DIR=logs/wfm
